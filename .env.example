# MongoDB connection settings - Safe to leave as is for local testing - creates database counter
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=counter

# Set to true to drop the MongoDB database during `make start`.
CLEAR_MONGO_DB=false

# Set to true to clear model_management/model_registry/registry.json's dataset-
# version history and cached performance during `make start` (keeps registered
# models). Useful when switching to a new, unrelated golden dataset/use case.
CLEAR_MODEL_REGISTRY=false

# Only needed for training/evaluation (model_management/training/yolo_training/train.py
# or model_management/orchestrator.py). Sign up free at https://roboflow.com.
# Replace the dataset settings in model_management/config.py before running.
ROBOFLOW_API_KEY=

# Google Drive OAuth "Desktop app" client (Google Cloud Console -> APIs & Services
# -> Credentials). GOOGLE_DRIVE_FOLDER_ID is optional: the parent folder the
# "Model-training-ObjectCounter" folder is created under (defaults to "My Drive").
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
